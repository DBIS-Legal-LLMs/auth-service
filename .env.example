# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=auth_service

# RSA signing key persistence (generated on first run if missing)
KEYS_DIR=./keys

# Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated list of allowed browser origins (only matters for apps that
# call this service directly from the browser rather than through their own
# same-origin proxy)
CORS_ALLOWED_ORIGINS=http://localhost:3000
