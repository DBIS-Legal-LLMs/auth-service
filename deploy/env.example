# Copy to .env in the stack directory (never commit it).
# Generate secrets with:  openssl rand -base64 24 | tr -d '/+='
# Fernet key:             python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ---- which environment is this? -------------------------------------------
ENVIRONMENT=prod                      # prod | dev  (decides the Docker network dbis-<env>)
COMPOSE_PROJECT_NAME=auth-prod        # auth-prod | auth-dev
IMAGE_TAG=prod                        # prod (built from main) | dev (built from dev)
IMAGE_REGISTRY=ghcr.io/dbis-legal-llms

# ---- how it is reached ------------------------------------------------------
# By default auth-service has NO public address: GRIPL reaches it inside the
# environment network and proxies only login/register to it. Set AUTH_EXPOSE=true
# (and AUTH_HOST) only if a browser app must call it directly.
AUTH_EXPOSE=false
#   prod: auth.134.60.71.167.nip.io     dev: auth-dev.134.60.71.167.nip.io
AUTH_HOST=auth.134.60.71.167.nip.io
# Only used when AUTH_EXPOSE=true. Comma-separated CIDRs; dev: the university network.
ALLOWED_CIDRS=0.0.0.0/0,::/0
# Browser origins that call auth-service directly (comma separated). GRIPL does not need one.
CORS_ALLOWED_ORIGINS=

# ---- secrets ---------------------------------------------------------------
MONGO_ROOT_USER=auth
MONGO_ROOT_PASSWORD=
MONGO_DB_NAME=auth_db
# Encrypts every user's stored OpenRouter key. Losing or changing it makes those keys unreadable.
# Use a DIFFERENT key in dev than in prod.
SECRETS_ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

#MEM_AUTH=512m
#MEM_MONGO=768m
